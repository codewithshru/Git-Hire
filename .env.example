# GitHire root environment template (copy to .env — NEVER commit the real file)
# Backend and frontend have their own detailed templates:
#   backend/.env.example
#   frontend/.env.example
VITE_API_BASE_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/githire
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=generate-and-paste-a-long-random-string-here
