# GitHire backend environment template
# Copy to .env and fill in values. NEVER commit the real .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (local PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/githire

# --- Redis (local Memurai) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate-and-paste-a-long-random-string-here

# --- OAuth (create apps in provider consoles) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI provider (adapter-based) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- AWS S3 (storage adapter) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=githire-local
